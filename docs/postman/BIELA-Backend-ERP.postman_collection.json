{
  "info": {
    "_postman_id": "41bb9175-64af-43b5-9125-7c948f3385fe",
    "name": "BIELA Backend ERP",
    "description": "Consolidated Gateway-only release verification for BIELA backend Phases 1-8. It uses generated fixtures and safe runtime credential injection; it never stores administrator credentials or tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "const special = {'P8 13 Reject Purchase Overpayment':409,'P8 21 Reject Excess Supplier Refund':409,'02 Administrator Login':200,'23 Reject Overpayment':409,'36 Reject Excessive Refund':409,'41 Reject Excessive MANUAL_OUT':409,'43B Reject Invariant-Breaking Reversal':409,'51 Reject Movement After Close':409,'52 Reject Duplicate Close':409,'53 Unauthenticated Request Rejected':401,'55 Restricted User Login':200,'56 Restricted User Forbidden':403};",
          "const expected = special[pm.info.requestName] ?? (pm.request.method === 'POST' ? 201 : 200);",
          "pm.test(`${pm.info.requestName} returns ${expected}`, () => pm.response.to.have.status(expected));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 System Health and Run Data",
      "auth": {
        "type": "noauth"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = `${Date.now()}-${Math.floor(Math.random()*100000)}`;",
              "const yesterday = new Date(Date.now()-172800000).toISOString().slice(0,10);",
              "pm.environment.set('runSuffix', suffix);",
              "pm.environment.set('pastDueDate', yesterday);",
              "pm.environment.set('restrictedEmail', `phase8-${suffix}@example.invalid`);",
              "pm.environment.set('restrictedPassword', `Phase8-${suffix}-Aa1!`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/system/health"
      }
    },
    {
      "name": "02 Administrator Login",
      "auth": {
        "type": "noauth"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body=pm.response.json(); pm.environment.set('accessToken',body.accessToken); pm.environment.set('adminAccessToken',body.accessToken);",
              "pm.test('token is returned without password hash',()=>{pm.expect(body.accessToken).to.be.a('string');pm.expect(body).not.to.have.property('passwordHash');});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
