      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{cashMethodId}}\",\"cashSessionId\":\"{{sessionId}}\",\"amount\":\"31.00\"}"
        },
        "url": "{{baseUrl}}/api/sale-returns/{{returnId}}/refunds"
      }
    },
    {
      "name": "34 Verify Refund Decreased Cash",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cash Refund is physical outflow',()=>pm.expect(pm.response.json().expectedCash).to.eql('119'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "35 Verify Refund Did Not Change Inventory",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refund is Inventory-neutral',()=>pm.expect(String(pm.response.json().totalQuantity)).to.eql(pm.environment.get('inventoryBeforeRefund')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}/inventory"
      }
    },
    {
      "name": "36 Reject Excessive Refund",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{cardMethodId}}\",\"amount\":\"20.00\"}"
        },
        "url": "{{baseUrl}}/api/sale-returns/{{returnId}}/refunds"
      }
    },
    {
      "name": "37 Create MANUAL_IN",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"MANUAL_IN\",\"amount\":\"10.00\",\"reason\":\"Add change fund\"}"
        },
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/movements"
      }
    },
    {
      "name": "38 Verify MANUAL_IN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('MANUAL_IN increases expected',()=>pm.expect(pm.response.json().expectedCash).to.eql('129'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "39 Create MANUAL_OUT",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"MANUAL_OUT\",\"amount\":\"5.00\",\"reason\":\"Remove change fund\"}"
        },
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/movements"
      }
    },
    {
      "name": "40 Verify MANUAL_OUT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('MANUAL_OUT decreases expected',()=>pm.expect(pm.response.json().expectedCash).to.eql('124'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "41 Reject Excessive MANUAL_OUT",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"MANUAL_OUT\",\"amount\":\"1000.00\",\"reason\":\"Must remain non-negative\"}"
        },
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/movements"
      }
    },
    {
      "name": "42 Read Complete Session Summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const b=pm.response.json();pm.test('summary contains ledger categories',()=>{pm.expect(b.movementTotals.SALE_PAYMENT).to.eql('50');pm.expect(b.movementTotals.SALE_REFUND).to.eql('31');pm.expect(b.paymentTotalsByMethod).to.be.an('array');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "43 Read Sale Payment History",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/sales/{{saleId}}/payments?page=1&limit=20"
      }
    },
    {
      "name": "43B Reject Invariant-Breaking Reversal",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Would leave Refunds above active Payments\"}"
        },
        "url": "{{baseUrl}}/api/payments/{{cardPaymentId}}/reverse"
      }
    },
    {
      "name": "44 Reverse Eligible CASH Payment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Reverse second tender\",\"cashSessionId\":\"{{sessionId}}\"}"
        },
        "url": "{{baseUrl}}/api/payments/{{secondPaymentId}}/reverse"
      }
    },
    {
      "name": "45 Verify Reversed Sale Balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const s=pm.response.json().paymentSummary;pm.test('reversal restores outstanding',()=>{pm.expect(s.settlementStatus).to.eql('UNPAID');pm.expect(s.outstandingAmount).to.eql('20');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/sales/{{secondSaleId}}"
      }
    },
    {
      "name": "46 Reverse CASH Refund",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Reverse test Refund\",\"cashSessionId\":\"{{sessionId}}\"}"
        },
        "url": "{{baseUrl}}/api/payments/{{refundId}}/reverse"
      }
    },
    {
      "name": "47 Verify Refund Capacity Restored",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refund reversal restores capacity',()=>pm.expect(pm.response.json().refundSummary.refundableAmount).to.eql('50'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/sale-returns/{{returnId}}"
      }
    },
    {
      "name": "48 Verify Compensating Cash Movements",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const b=pm.response.json();pm.test('compensations restore expected Cash',()=>{pm.expect(b.expectedCash).to.eql('135');pm.expect(b.movementTotals.SALE_PAYMENT_REVERSAL).to.eql('20');pm.expect(b.movementTotals.SALE_REFUND_REVERSAL).to.eql('31');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "49 Close Cash Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const b=pm.response.json();pm.test('close snapshots expected/count/difference',()=>{pm.expect(b.status).to.eql('CLOSED');pm.expect(b.expectedAmount).to.eql('135');pm.expect(b.countedAmount).to.eql('136');pm.expect(b.differenceAmount).to.eql('1');});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"countedAmount\":\"136.00\",\"notes\":\"One unit close difference\"}"
        },
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/close"
      }
    },
    {
      "name": "50 Read CLOSED Session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "51 Reject Movement After Close",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"MANUAL_IN\",\"amount\":\"1.00\",\"reason\":\"Closed session rejection\"}"
        },
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/movements"
      }
    },
    {
      "name": "52 Reject Duplicate Close",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"countedAmount\":\"135.00\"}" },
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/close"
      }
    },
    {
      "name": "53 Unauthenticated Request Rejected",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": ["pm.environment.set('accessToken','');"] }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('accessToken',pm.environment.get('adminAccessToken'));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/cash-sessions" }
    },
    {
      "name": "54 Create Restricted User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{restrictedEmail}}\",\"password\":\"{{restrictedPassword}}\",\"firstName\":\"Phase\",\"lastName\":\"Seven\"}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "55 Restricted User Login",
      "auth": { "type": "noauth" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('restrictedAccessToken',pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{restrictedEmail}}\",\"password\":\"{{restrictedPassword}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "56 Restricted User Forbidden",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('accessToken',pm.environment.get('restrictedAccessToken'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('accessToken',pm.environment.get('adminAccessToken'));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/payment-methods" }
    }
  ]
}
