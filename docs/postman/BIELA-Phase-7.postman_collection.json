        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Phase 7 eligible Return\",\"items\":[{\"saleItemId\":\"{{saleItemId}}\",\"destinationLocationId\":\"{{locationId}}\",\"quantityReturned\":1}]}"
        },
        "url": "{{baseUrl}}/api/sales/{{saleId}}/returns"
      }
    },
    {
      "name": "30 Post Sale Return",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/sale-returns/{{returnId}}/post"
      }
    },
    {
      "name": "31 Verify Refund Eligibility",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const s=pm.response.json().refundSummary;pm.test('Return value/refundable are exact',()=>{pm.expect(s.returnValue).to.eql('50');pm.expect(s.refundableAmount).to.eql('50');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/sale-returns/{{returnId}}"
      }
    },
    {
      "name": "32 Capture Inventory Before Refund",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('inventoryBeforeRefund',String(pm.response.json().totalQuantity));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}/inventory"
      }
    },
    {
      "name": "33 Create CASH Refund",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('refundId',pm.response.json().id);"]
          }
        }
