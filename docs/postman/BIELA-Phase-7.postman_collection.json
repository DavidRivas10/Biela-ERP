{
  "info": {
    "name": "BIELA Backend Phase 7",
    "description": "Gateway-only Phase 7 flow for exact Payments, Refunds, physical Cash, reversals, closing, Inventory isolation, authentication, and RBAC. Inject administrator credentials from the ignored local .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "const special = {'02 Administrator Login':200,'23 Reject Overpayment':409,'36 Reject Excessive Refund':409,'41 Reject Excessive MANUAL_OUT':409,'43B Reject Invariant-Breaking Reversal':409,'51 Reject Movement After Close':409,'52 Reject Duplicate Close':409,'53 Unauthenticated Request Rejected':401,'55 Restricted User Login':200,'56 Restricted User Forbidden':403};",
          "const expected = special[pm.info.requestName] ?? (pm.request.method === 'POST' ? 201 : 200);",
          "pm.test(`${pm.info.requestName} returns ${expected}`, () => pm.response.to.have.status(expected));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 System Health and Run Data",
      "auth": { "type": "noauth" },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = `${Date.now()}-${Math.floor(Math.random()*100000)}`;",
              "pm.environment.set('runSuffix', suffix);",
              "pm.environment.set('restrictedEmail', `phase7-${suffix}@example.invalid`);",
              "pm.environment.set('restrictedPassword', `Phase7-${suffix}-Aa1!`);"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/system/health" }
    },
    {
      "name": "02 Administrator Login",
      "auth": { "type": "noauth" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body=pm.response.json(); pm.environment.set('accessToken',body.accessToken); pm.environment.set('adminAccessToken',body.accessToken);",
              "pm.test('token is returned without password hash',()=>{pm.expect(body.accessToken).to.be.a('string');pm.expect(body).not.to.have.property('passwordHash');});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "03 Create Product Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('categoryId',pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-CAT-{{runSuffix}}\",\"name\":\"Phase 7 Category\"}"
        },
        "url": "{{baseUrl}}/api/product-categories"
      }
    },
    {
      "name": "04 Create Product Brand",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('brandId',pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-BRAND-{{runSuffix}}\",\"name\":\"Phase 7 Brand\"}"
        },
        "url": "{{baseUrl}}/api/product-brands"
      }
    },
    {
      "name": "05 Create Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('productId',pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-PROD-{{runSuffix}}\",\"name\":\"Phase 7 Part\",\"categoryId\":\"{{categoryId}}\",\"brandId\":\"{{brandId}}\",\"defaultSalePrice\":\"50.0000\"}"
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "06 Create Location",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('locationId',pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-LOC-{{runSuffix}}\",\"name\":\"Phase 7 Location\"}"
        },
        "url": "{{baseUrl}}/api/locations"
      }
    },
    {
      "name": "07 Establish Known Inventory",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"INITIAL\",\"productId\":\"{{productId}}\",\"destinationLocationId\":\"{{locationId}}\",\"quantity\":10,\"reason\":\"Phase 7 deterministic fixture\"}"
        },
        "url": "{{baseUrl}}/api/inventory/movements"
      }
    },
    {
      "name": "08 Create Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('customerId',pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-CUS-{{runSuffix}}\",\"name\":\"Phase 7 Customer\"}"
        },
        "url": "{{baseUrl}}/api/customers"
      }
    },
    {
      "name": "09 Create CASH Payment Method",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body=pm.response.json();pm.environment.set('cashMethodId',body.id);pm.test('kind is controlled CASH',()=>pm.expect(body.kind).to.eql('CASH'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-CASH-{{runSuffix}}\",\"name\":\"Phase 7 Cash\",\"kind\":\"CASH\"}"
        },
        "url": "{{baseUrl}}/api/payment-methods"
      }
    },
    {
      "name": "10 Create CARD Payment Method",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('cardMethodId',pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-CARD-{{runSuffix}}\",\"name\":\"Phase 7 Card\",\"kind\":\"CARD\"}"
        },
        "url": "{{baseUrl}}/api/payment-methods"
      }
    },
    {
      "name": "11 Create Cash Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('registerId',pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P7-REG-{{runSuffix}}\",\"name\":\"Phase 7 Register\"}"
        },
        "url": "{{baseUrl}}/api/cash-registers"
      }
    },
    {
      "name": "12 Open Cash Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('sessionId',pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"openingAmount\":\"100.00\",\"notes\":\"Phase 7 opening\"}"
        },
        "url": "{{baseUrl}}/api/cash-registers/{{registerId}}/sessions/open"
      }
    },
    {
      "name": "13 Verify Opening Expected Cash",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected Cash equals opening',()=>pm.expect(pm.response.json().expectedCash).to.eql('100'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "14 Create First Sale",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body=pm.response.json();pm.environment.set('saleId',body.id);pm.environment.set('saleItemId',body.items[0].id);pm.test('Sale total is exact',()=>pm.expect(body.total).to.eql('100.00'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\":\"{{customerId}}\",\"documentDate\":\"2026-08-19\",\"items\":[{\"productId\":\"{{productId}}\",\"sourceLocationId\":\"{{locationId}}\",\"quantity\":2,\"unitPrice\":\"50.0000\"}]}"
        },
        "url": "{{baseUrl}}/api/sales"
      }
    },
    {
      "name": "15 Post First Sale",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/sales/{{saleId}}/post"
      }
    },
    {
      "name": "16 Verify Sale UNPAID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Sale starts UNPAID',()=>pm.expect(pm.response.json().paymentSummary.settlementStatus).to.eql('UNPAID'));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/sales/{{saleId}}" }
    },
    {
      "name": "17 Record Partial CASH Payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('cashPaymentId',pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{cashMethodId}}\",\"cashSessionId\":\"{{sessionId}}\",\"amount\":\"30.00\"}"
        },
        "url": "{{baseUrl}}/api/sales/{{saleId}}/payments"
      }
    },
    {
      "name": "18 Verify Sale PARTIALLY_PAID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const s=pm.response.json().paymentSummary;pm.test('partial balance is exact',()=>{pm.expect(s.paidAmount).to.eql('30');pm.expect(s.outstandingAmount).to.eql('70');pm.expect(s.settlementStatus).to.eql('PARTIALLY_PAID');});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/sales/{{saleId}}" }
    },
    {
      "name": "19 Verify CASH Increased Expected",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CASH applies net amount',()=>pm.expect(pm.response.json().expectedCash).to.eql('130'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "20 Pay Remaining with CARD",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('cardPaymentId',pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{cardMethodId}}\",\"amount\":\"70.00\",\"externalReference\":\"P7-CARD-AUTH\"}"
        },
        "url": "{{baseUrl}}/api/sales/{{saleId}}/payments"
      }
    },
    {
      "name": "21 Verify Sale PAID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('split Payment settles Sale',()=>pm.expect(pm.response.json().paymentSummary.settlementStatus).to.eql('PAID'));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/sales/{{saleId}}" }
    },
    {
      "name": "22 Verify CARD Did Not Change Cash",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('non-cash has no physical effect',()=>pm.expect(pm.response.json().expectedCash).to.eql('130'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "23 Reject Overpayment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{cardMethodId}}\",\"amount\":\"0.01\"}"
        },
        "url": "{{baseUrl}}/api/sales/{{saleId}}/payments"
      }
    },
    {
      "name": "24 Create Second Sale",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('secondSaleId',pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"documentDate\":\"2026-08-19\",\"items\":[{\"productId\":\"{{productId}}\",\"sourceLocationId\":\"{{locationId}}\",\"quantity\":1,\"unitPrice\":\"20.0000\"}]}"
        },
        "url": "{{baseUrl}}/api/sales"
      }
    },
    {
      "name": "25 Post Second Sale",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/sales/{{secondSaleId}}/post"
      }
    },
    {
      "name": "26 Pay with Tender and Change",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body=pm.response.json();pm.environment.set('secondPaymentId',body.id);pm.test('change is exact',()=>{pm.expect(body.tenderedAmount).to.eql('25');pm.expect(body.changeAmount).to.eql('5');});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":\"{{cashMethodId}}\",\"cashSessionId\":\"{{sessionId}}\",\"amount\":\"20.00\",\"tenderedAmount\":\"25.00\"}"
        },
        "url": "{{baseUrl}}/api/sales/{{secondSaleId}}/payments"
      }
    },
    {
      "name": "27 Read Tender Payment",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/payments/{{secondPaymentId}}"
      }
    },
    {
      "name": "28 Verify Net CASH Amount",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('drawer gains applied amount only',()=>pm.expect(pm.response.json().expectedCash).to.eql('150'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "29 Create Sale Return",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set('returnId',pm.response.json().id);"]
