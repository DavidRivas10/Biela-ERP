          "script": {
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json(); pm.environment.set(\"accessToken\", json.accessToken);",
              "pm.test(\"access token returned\", function () { pm.expect(json.accessToken).to.be.a(\"string\").and.not.empty; });"
