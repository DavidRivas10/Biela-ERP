{
  "info": {
    "_postman_id": "c42815eb-0695-4d11-bf4a-ebad9ac05cad",
    "name": "BIELA Backend MVP",
    "description": "Consolidated Gateway-only validation for BIELA Backend Phases 1-3 and Phase 4 stabilization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get(\"runSuffix\")) {",
          "  const suffix = Date.now().toString();",
          "  pm.environment.set(\"runSuffix\", suffix);",
          "  pm.environment.set(\"restrictedPassword\", `Mvp-${suffix}-Safe!`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 System Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"all services and databases are healthy\", function () { const j = pm.response.json(); pm.expect(j.status).to.eql(\"ok\"); pm.expect(j.services.gateway.status).to.eql(\"ok\"); pm.expect(j.services.users.status).to.eql(\"ok\"); pm.expect(j.services.users.database).to.eql(\"connected\"); pm.expect(j.services.autorepuesto.status).to.eql(\"ok\"); pm.expect(j.services.autorepuesto.database).to.eql(\"connected\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/system/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "system", "health"]
        }
      },
      "response": []
    },
    {
      "name": "02 Administrator Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json(); pm.environment.set(\"accessToken\", j.accessToken);",
              "pm.test(\"token returned without password hash\", function () { const j = pm.response.json(); pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(JSON.stringify(j)).not.to.include(\"passwordHash\"); });"
