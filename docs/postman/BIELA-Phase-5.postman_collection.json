        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Location created', () => { pm.response.to.have.status(201); pm.environment.set('locationId', pm.response.json().id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P5-LOC-{{runSuffix}}\",\"name\":\"Phase 5 Receiving\"}"
        },
        "url": "{{baseUrl}}/api/locations"
      }
