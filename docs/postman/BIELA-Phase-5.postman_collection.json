      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{restrictedEmail}}\",\"password\":\"{{restrictedPassword}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "34 Restricted User Forbidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('authenticated user without permission is forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{restrictedAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/suppliers"
      }
    }
  ]
}
