{
  "info": {
    "name": "BIELA Backend Phase 5",
    "description": "Gateway-only Supplier, Purchase, receiving, return, Inventory traceability, and RBAC flow. Inject administrator credentials from the ignored local .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 System Health and Run Data",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
              "pm.environment.set('runSuffix', suffix);",
              "pm.environment.set('restrictedEmail', `phase5-${suffix}@example.invalid`);",
              "pm.environment.set('restrictedPassword', `Phase5-${suffix}-Aa1!`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('system is healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/system/health" }
    },
    {
      "name": "02 Administrator Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login succeeds safely', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.accessToken).to.be.a('string'); pm.expect(body).not.to.have.property('passwordHash'); pm.environment.set('accessToken', body.accessToken); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "03 Create Supplier",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Supplier is created and normalized', () => { pm.response.to.have.status(201); const body = pm.response.json(); pm.expect(body.code).to.eql(`SUP-${pm.environment.get('runSuffix')}`.toUpperCase()); pm.environment.set('supplierId', body.id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"sup-{{runSuffix}}\",\"businessName\":\"Phase 5 Supplier {{runSuffix}}\",\"email\":\"purchasing@example.invalid\"}"
        },
        "url": "{{baseUrl}}/api/suppliers"
      }
    },
    {
      "name": "04 Create Product Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('category created', () => { pm.response.to.have.status(201); pm.environment.set('categoryId', pm.response.json().id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P5-CAT-{{runSuffix}}\",\"name\":\"Phase 5 Category {{runSuffix}}\"}"
        },
        "url": "{{baseUrl}}/api/product-categories"
      }
    },
    {
      "name": "05 Create Product Brand",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('brand created', () => { pm.response.to.have.status(201); pm.environment.set('brandId', pm.response.json().id); });"
