      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P5-BRAND-{{runSuffix}}\",\"name\":\"Phase 5 Brand {{runSuffix}}\"}"
        },
        "url": "{{baseUrl}}/api/product-brands"
      }
