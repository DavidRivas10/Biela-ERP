    {
      "name": "08 Record Initial Stock",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('initial stock recorded', () => { pm.response.to.have.status(200); const total = pm.response.json().totalQuantity; pm.environment.set('initialStock', String(total)); pm.expect(total).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}/inventory"
      }
    },
    {
      "name": "09 Create Purchase for 10",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Purchase totals are exact', () => { pm.response.to.have.status(201); const body = pm.response.json(); pm.expect(body.status).to.eql('DRAFT'); pm.expect(body.subtotal).to.eql('123.46'); pm.expect(body.discountTotal).to.eql('1.00'); pm.expect(body.taxTotal).to.eql('2.00'); pm.expect(body.total).to.eql('124.46'); pm.environment.set('purchaseId', body.id); pm.environment.set('purchaseItemId', body.items[0].id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"supplierId\":\"{{supplierId}}\",\"supplierDocumentNumber\":\"INV-{{runSuffix}}\",\"documentDate\":\"2026-08-19\",\"items\":[{\"productId\":\"{{productId}}\",\"orderedQuantity\":10,\"unitCost\":\"12.3456\",\"discountAmount\":\"1.00\",\"taxAmount\":\"2.00\"}]}"
        },
        "url": "{{baseUrl}}/api/purchases"
      }
    },
    {
      "name": "10 Confirm Purchase",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Purchase confirmed without receiving', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });"
