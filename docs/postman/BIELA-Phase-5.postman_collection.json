        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"P5-PROD-{{runSuffix}}\",\"name\":\"Phase 5 Purchased Part\",\"categoryId\":\"{{categoryId}}\",\"brandId\":\"{{brandId}}\"}"
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "07 Create Receiving Location",
