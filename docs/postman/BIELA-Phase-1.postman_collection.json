{
  "info": {
    "name": "BIELA Backend Phase 1",
    "description": "Run in order after starting both databases, all services, and seeding the administrator. Set adminEmail, adminPassword, and testUserPassword locally; no credentials are committed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Gateway health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Gateway is healthy', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. ms-users health",
      "request": { "method": "GET", "url": "{{usersUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('MongoDB is connected', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().database).to.eql('connected'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. ms-autorepuesto health",
      "request": { "method": "GET", "url": "{{autorepuestoUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('PostgreSQL is connected', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().database).to.eql('connected'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Aggregated system health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/system/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('All services are healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Admin login through Gateway",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const data = pm.response.json();",
              "pm.expect(data.accessToken).to.be.a('string');",
              "pm.environment.set('accessToken', data.accessToken);",
              "pm.environment.set('testUserEmail', `phase1-${Date.now()}@example.invalid`);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Authenticated auth/me",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Authenticated user is returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().email).to.eql(pm.environment.get('adminEmail').toLowerCase()); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. List users",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/users?page=1&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User list is paginated', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.keys('data', 'meta'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Create user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"User\"\n}"
        },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User is created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "pm.environment.set('testUserId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Update user",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Updated Postman\"\n}"
        },
        "url": "{{baseUrl}}/api/users/{{testUserId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User is updated', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().firstName).to.eql('Updated Postman'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Deactivate user",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/users/{{testUserId}}/deactivate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User is inactive', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().active).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Inactive user login is rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Inactive login is rejected', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Reactivate user",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/users/{{testUserId}}/activate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User is active', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().active).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Login reactivated user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Reactivated login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "pm.environment.set('testUserToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Permission rejection test",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{testUserToken}}" }
        ],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User without users.read is forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Admin role permission success",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/roles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Administrator can read roles', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    }
  ]
}
