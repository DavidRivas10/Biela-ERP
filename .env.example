# Copy this file to .env for local development. Values below are examples only.

# MongoDB (owned by ms-users)
MONGO_INITDB_ROOT_USERNAME=biela_root
MONGO_INITDB_ROOT_PASSWORD=change_me_for_local_development
MONGO_DATABASE=biela_users

# PostgreSQL (owned by ms-autorepuesto)
POSTGRES_USER=biela_app
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=biela_autorepuesto

# ms-users
MS_USERS_PORT=4001
MS_USERS_MONGO_URI=mongodb://biela_root:change_me_for_local_development@localhost:27017/biela_users?authSource=admin
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ms-autorepuesto
MS_AUTOREPUESTO_PORT=4002
DATABASE_URL=postgresql://biela_app:change_me_for_local_development@localhost:5432/biela_autorepuesto?schema=public

# api-gateway
API_GATEWAY_PORT=4000
MS_USERS_URL=http://localhost:4001
MS_AUTOREPUESTO_URL=http://localhost:4002
UPSTREAM_TIMEOUT_MS=5000

# Initial development administrator (used only by npm run seed:admin)
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace_with_a_strong_local_password
SEED_ADMIN_FIRST_NAME=Local
SEED_ADMIN_LAST_NAME=Administrator
