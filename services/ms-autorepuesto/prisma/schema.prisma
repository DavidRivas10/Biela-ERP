generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductAttributeValueType {
  STRING
  NUMBER
  BOOLEAN
}

model ProductCategory {
  id                   String                       @id @default(uuid()) @db.Uuid
  code                 String                       @unique @db.VarChar(60)
  name                 String                       @db.VarChar(120)
  description          String?                      @db.VarChar(500)
  active               Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  products             Product[]
  attributeDefinitions ProductAttributeDefinition[]

  @@index([active])
}

model ProductBrand {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(60)
  name      String    @db.VarChar(120)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active])
}

model Product {
  id              String                  @id @default(uuid()) @db.Uuid
  code            String                  @unique @db.VarChar(80)
  name            String                  @db.VarChar(160)
  description     String?                 @db.VarChar(1000)
  categoryId      String                  @db.Uuid
  brandId         String                  @db.Uuid
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  category        ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand           ProductBrand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  attributes      ProductAttributeValue[]
  compatibilities ProductCompatibility[]

  @@index([categoryId])
  @@index([brandId])
  @@index([active])
}

model ProductAttributeDefinition {
  id         String                    @id @default(uuid()) @db.Uuid
  categoryId String                    @db.Uuid
  code       String                    @db.VarChar(60)
  name       String                    @db.VarChar(120)
  valueType  ProductAttributeValueType
  unit       String?                   @db.VarChar(30)
  required   Boolean                   @default(false)
  active     Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  category   ProductCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  values     ProductAttributeValue[]

  @@unique([categoryId, code])
  @@index([categoryId, active])
}

model ProductAttributeValue {
  id           String                     @id @default(uuid()) @db.Uuid
  productId    String                     @db.Uuid
  definitionId String                     @db.Uuid
  value        String                     @db.VarChar(250)
  product      Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition   ProductAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([productId, definitionId])
  @@index([definitionId])
}

model VehicleBrand {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique @db.VarChar(60)
  name      String         @db.VarChar(120)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]

  @@index([active])
}

model VehicleModel {
  id        String       @id @default(uuid()) @db.Uuid
  brandId   String       @db.Uuid
  code      String       @db.VarChar(60)
  name      String       @db.VarChar(120)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  brand     VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  vehicles  Vehicle[]

  @@unique([brandId, code])
  @@index([brandId, active])
}

model Vehicle {
  id              String                 @id @default(uuid()) @db.Uuid
  modelId         String                 @db.Uuid
  year            Int
  engine          String                 @db.VarChar(80)
  generation      String?                @db.VarChar(80)
  trim            String?                @db.VarChar(80)
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  model           VehicleModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  compatibilities ProductCompatibility[]

  @@index([modelId])
  @@index([year])
  @@index([active])
}

model ProductCompatibility {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  vehicleId String   @db.Uuid
  notes     String?  @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([productId, vehicleId])
  @@index([productId])
  @@index([vehicleId])
  @@index([active])
}

// Inventory, sales, workshop, and intelligence data remain out of scope.
