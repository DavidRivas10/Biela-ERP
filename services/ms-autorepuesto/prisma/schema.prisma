generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductAttributeValueType {
  STRING
  NUMBER
  BOOLEAN
}

enum InventoryMovementType {
  INITIAL
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum InventoryMovementReferenceType {
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALE
  SALE_RETURN
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchasingDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentMethodKind {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum PaymentType {
  SALE_PAYMENT
  SALE_REFUND
  PURCHASE_PAYMENT
  SUPPLIER_REFUND
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum CashMovementType {
  SALE_PAYMENT
  SALE_PAYMENT_REVERSAL
  SALE_REFUND
  SALE_REFUND_REVERSAL
  PURCHASE_PAYMENT
  PURCHASE_PAYMENT_REVERSAL
  SUPPLIER_REFUND
  SUPPLIER_REFUND_REVERSAL
  MANUAL_IN
  MANUAL_OUT
}

model ProductCategory {
  id                   String                       @id @default(uuid()) @db.Uuid
  code                 String                       @unique @db.VarChar(60)
  name                 String                       @db.VarChar(120)
  description          String?                      @db.VarChar(500)
  active               Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  products             Product[]
  attributeDefinitions ProductAttributeDefinition[]

  @@index([active])
}

model ProductBrand {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(60)
  name      String    @db.VarChar(120)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active])
}

model Product {
  id                 String                  @id @default(uuid()) @db.Uuid
  code               String                  @unique @db.VarChar(80)
  name               String                  @db.VarChar(160)
  description        String?                 @db.VarChar(1000)
  categoryId         String                  @db.Uuid
  brandId            String                  @db.Uuid
  active             Boolean                 @default(true)
  defaultSalePrice   Decimal?                @db.Decimal(18, 4)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  category           ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              ProductBrand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  attributes         ProductAttributeValue[]
  compatibilities    ProductCompatibility[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([active])
}

model ProductAttributeDefinition {
  id         String                    @id @default(uuid()) @db.Uuid
  categoryId String                    @db.Uuid
  code       String                    @db.VarChar(60)
  name       String                    @db.VarChar(120)
  valueType  ProductAttributeValueType
  unit       String?                   @db.VarChar(30)
  required   Boolean                   @default(false)
  active     Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  category   ProductCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  values     ProductAttributeValue[]

  @@unique([categoryId, code])
  @@index([categoryId, active])
}

model ProductAttributeValue {
  id           String                     @id @default(uuid()) @db.Uuid
  productId    String                     @db.Uuid
  definitionId String                     @db.Uuid
  value        String                     @db.VarChar(250)
  product      Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition   ProductAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([productId, definitionId])
  @@index([definitionId])
}

model VehicleBrand {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique @db.VarChar(60)
  name      String         @db.VarChar(120)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]

  @@index([active])
}

model VehicleModel {
  id        String       @id @default(uuid()) @db.Uuid
  brandId   String       @db.Uuid
  code      String       @db.VarChar(60)
  name      String       @db.VarChar(120)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  brand     VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  vehicles  Vehicle[]

  @@unique([brandId, code])
  @@index([brandId, active])
}

model Vehicle {
  id              String                 @id @default(uuid()) @db.Uuid
  modelId         String                 @db.Uuid
  year            Int
  engine          String                 @db.VarChar(80)
  generation      String?                @db.VarChar(80)
  trim            String?                @db.VarChar(80)
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  model           VehicleModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  compatibilities ProductCompatibility[]

  @@index([modelId])
  @@index([year])
  @@index([active])
}

model ProductCompatibility {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  vehicleId String   @db.Uuid
  notes     String?  @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([productId, vehicleId])
  @@index([productId])
  @@index([vehicleId])
  @@index([active])
}

model Location {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique @db.VarChar(60)
  name                String               @db.VarChar(120)
  description         String?              @db.VarChar(500)
  zone                String?              @db.VarChar(80)
  aisle               String?              @db.VarChar(40)
  rack                String?              @db.VarChar(40)
  shelf               String?              @db.VarChar(40)
  bin                 String?              @db.VarChar(40)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inventories         Inventory[]
  outgoingMovements   InventoryMovement[]  @relation("MovementSourceLocation")
  incomingMovements   InventoryMovement[]  @relation("MovementDestinationLocation")
  purchaseReceipts    PurchaseReceipt[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]

  @@index([active])
}

model Inventory {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  locationId String   @db.Uuid
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId])
}

model InventoryMovement {
  id                        String                          @id @default(uuid()) @db.Uuid
  productId                 String                          @db.Uuid
  sourceLocationId          String?                         @db.Uuid
  destinationLocationId     String?                         @db.Uuid
  type                      InventoryMovementType
  quantity                  Int
  reason                    String?                         @db.VarChar(500)
  actorId                   String                          @db.VarChar(120)
  sourceQuantityBefore      Int?
  sourceQuantityAfter       Int?
  destinationQuantityBefore Int?
  destinationQuantityAfter  Int?
  referenceType             InventoryMovementReferenceType?
  referenceId               String?                         @db.Uuid
  referenceItemId           String?                         @db.Uuid
  createdAt                 DateTime                        @default(now())
  product                   Product                         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation            Location?                       @relation("MovementSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation       Location?                       @relation("MovementDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)

  @@unique([referenceType, referenceItemId])
  @@index([productId, createdAt])
  @@index([sourceLocationId, createdAt])
  @@index([destinationLocationId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model Supplier {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique @db.VarChar(60)
  businessName String     @db.VarChar(160)
  taxId        String?    @db.VarChar(40)
  contactName  String?    @db.VarChar(120)
  phone        String?    @db.VarChar(40)
  email        String?    @db.VarChar(160)
  address      String?    @db.VarChar(500)
  notes        String?    @db.VarChar(1000)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]

  @@index([businessName])
  @@index([active])
}

model Purchase {
  id                     String            @id @default(uuid()) @db.Uuid
  number                 Int               @unique @default(autoincrement())
  supplierId             String            @db.Uuid
  supplierDocumentNumber String?           @db.VarChar(80)
  documentDate           DateTime          @db.Date
  paymentDueDate         DateTime?         @db.Date
  status                 PurchaseStatus    @default(DRAFT)
  notes                  String?           @db.VarChar(1000)
  subtotal               Decimal           @default(0) @db.Decimal(18, 2)
  discountTotal          Decimal           @default(0) @db.Decimal(18, 2)
  taxTotal               Decimal           @default(0) @db.Decimal(18, 2)
  total                  Decimal           @default(0) @db.Decimal(18, 2)
  createdByActorId       String            @db.VarChar(120)
  confirmedByActorId     String?           @db.VarChar(120)
  confirmedAt            DateTime?
  cancelledByActorId     String?           @db.VarChar(120)
  cancelledAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  supplier               Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                  PurchaseItem[]
  receipts               PurchaseReceipt[]
  returns                PurchaseReturn[]
  payments               Payment[]

  @@index([supplierId, documentDate])
  @@index([status, documentDate])
  @@index([supplierId, paymentDueDate, status])
  @@index([paymentDueDate, status])
  @@index([supplierDocumentNumber])
}

model PurchaseItem {
  id              String                @id @default(uuid()) @db.Uuid
  purchaseId      String                @db.Uuid
  productId       String                @db.Uuid
  orderedQuantity Int
  unitCost        Decimal               @db.Decimal(18, 4)
  discountAmount  Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal               @default(0) @db.Decimal(18, 2)
  lineSubtotal    Decimal               @db.Decimal(18, 2)
  lineTotal       Decimal               @db.Decimal(18, 2)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  purchase        Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems    PurchaseReceiptItem[]
  returnItems     PurchaseReturnItem[]

  @@unique([purchaseId, productId])
  @@index([productId])
}

model PurchaseReceipt {
  id                    String                   @id @default(uuid()) @db.Uuid
  number                Int                      @unique @default(autoincrement())
  purchaseId            String                   @db.Uuid
  destinationLocationId String                   @db.Uuid
  status                PurchasingDocumentStatus @default(DRAFT)
  receivedAt            DateTime?
  postedAt              DateTime?
  createdByActorId      String                   @db.VarChar(120)
  postedByActorId       String?                  @db.VarChar(120)
  notes                 String?                  @db.VarChar(1000)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  purchase              Purchase                 @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  destinationLocation   Location                 @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict)
  items                 PurchaseReceiptItem[]

  @@index([purchaseId, createdAt])
  @@index([destinationLocationId])
  @@index([status])
}

model PurchaseReceiptItem {
  id               String          @id @default(uuid()) @db.Uuid
  receiptId        String          @db.Uuid
  purchaseItemId   String          @db.Uuid
  quantityReceived Int
  createdAt        DateTime        @default(now())
  receipt          PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem    @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@unique([receiptId, purchaseItemId])
  @@index([purchaseItemId])
}

model PurchaseReturn {
  id               String                   @id @default(uuid()) @db.Uuid
  number           Int                      @unique @default(autoincrement())
  purchaseId       String                   @db.Uuid
  status           PurchasingDocumentStatus @default(DRAFT)
  reason           String                   @db.VarChar(500)
  postedAt         DateTime?
  createdByActorId String                   @db.VarChar(120)
  postedByActorId  String?                  @db.VarChar(120)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  purchase         Purchase                 @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  items            PurchaseReturnItem[]
  refunds          Payment[]

  @@index([purchaseId, createdAt])
  @@index([status])
}

model PurchaseReturnItem {
  id               String         @id @default(uuid()) @db.Uuid
  purchaseReturnId String         @db.Uuid
  purchaseItemId   String         @db.Uuid
  sourceLocationId String         @db.Uuid
  quantityReturned Int
  createdAt        DateTime       @default(now())
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  sourceLocation   Location       @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, purchaseItemId, sourceLocationId])
  @@index([purchaseItemId])
  @@index([sourceLocationId])
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(60)
  name         String   @db.VarChar(160)
  businessName String?  @db.VarChar(160)
  taxId        String?  @db.VarChar(40)
  contactName  String?  @db.VarChar(120)
  phone        String?  @db.VarChar(40)
  email        String?  @db.VarChar(160)
  address      String?  @db.VarChar(500)
  notes        String?  @db.VarChar(1000)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]

  @@index([name])
  @@index([businessName])
  @@index([taxId])
  @@index([active])
}

model Sale {
  id                 String       @id @default(uuid()) @db.Uuid
  number             Int          @unique @default(autoincrement())
  customerId         String?      @db.Uuid
  documentDate       DateTime     @db.Date
  paymentDueDate     DateTime?    @db.Date
  status             SaleStatus   @default(DRAFT)
  notes              String?      @db.VarChar(1000)
  subtotal           Decimal      @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal      @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal      @default(0) @db.Decimal(18, 2)
  total              Decimal      @default(0) @db.Decimal(18, 2)
  createdByActorId   String       @db.VarChar(120)
  postedByActorId    String?      @db.VarChar(120)
  postedAt           DateTime?
  cancelledByActorId String?      @db.VarChar(120)
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  customer           Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  returns            SaleReturn[]
  payments           Payment[]

  @@index([customerId, documentDate])
  @@index([status, documentDate])
  @@index([customerId, paymentDueDate, status])
  @@index([paymentDueDate, status])
  @@index([documentDate])
}

model SaleItem {
  id               String           @id @default(uuid()) @db.Uuid
  saleId           String           @db.Uuid
  productId        String           @db.Uuid
  sourceLocationId String           @db.Uuid
  quantity         Int
  unitPrice        Decimal          @db.Decimal(18, 4)
  discountAmount   Decimal          @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(18, 2)
  lineSubtotal     Decimal          @db.Decimal(18, 2)
  lineTotal        Decimal          @db.Decimal(18, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  sale             Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation   Location         @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  returnItems      SaleReturnItem[]

  @@unique([saleId, productId, sourceLocationId])
  @@index([productId])
  @@index([sourceLocationId])
}

model SaleReturn {
  id                 String           @id @default(uuid()) @db.Uuid
  number             Int              @unique @default(autoincrement())
  saleId             String           @db.Uuid
  status             SaleStatus       @default(DRAFT)
  reason             String           @db.VarChar(500)
  createdByActorId   String           @db.VarChar(120)
  postedByActorId    String?          @db.VarChar(120)
  postedAt           DateTime?
  cancelledByActorId String?          @db.VarChar(120)
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sale               Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items              SaleReturnItem[]
  refunds            Payment[]

  @@index([saleId, createdAt])
  @@index([status, createdAt])
}

model SaleReturnItem {
  id                    String     @id @default(uuid()) @db.Uuid
  saleReturnId          String     @db.Uuid
  saleItemId            String     @db.Uuid
  destinationLocationId String     @db.Uuid
  quantityReturned      Int
  createdAt             DateTime   @default(now())
  saleReturn            SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem              SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  destinationLocation   Location   @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict)

  @@unique([saleReturnId, saleItemId, destinationLocationId])
  @@index([saleItemId])
  @@index([destinationLocationId])
}

model PaymentMethod {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique @db.VarChar(60)
  name      String            @db.VarChar(120)
  kind      PaymentMethodKind
  active    Boolean           @default(true)
  notes     String?           @db.VarChar(500)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  payments  Payment[]

  @@index([kind, active])
  @@index([active])
}

model CashRegister {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(60)
  name        String        @db.VarChar(120)
  description String?       @db.VarChar(500)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessions    CashSession[]

  @@index([active])
}

model CashSession {
  id               String            @id @default(uuid()) @db.Uuid
  cashRegisterId   String            @db.Uuid
  status           CashSessionStatus @default(OPEN)
  openingAmount    Decimal           @db.Decimal(18, 2)
  openedByActorId  String            @db.VarChar(120)
  openedAt         DateTime          @default(now())
  openingNotes     String?           @db.VarChar(500)
  closedByActorId  String?           @db.VarChar(120)
  closedAt         DateTime?
  expectedAmount   Decimal?          @db.Decimal(18, 2)
  countedAmount    Decimal?          @db.Decimal(18, 2)
  differenceAmount Decimal?          @db.Decimal(18, 2)
  closingNotes     String?           @db.VarChar(500)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cashRegister     CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  movements        CashMovement[]
  originalPayments Payment[]         @relation("OriginalPaymentSession")
  reversalPayments Payment[]         @relation("ReversalPaymentSession")

  @@index([cashRegisterId, openedAt])
  @@index([status, openedAt])
  @@index([openedByActorId, openedAt])
}

model Payment {
  id                    String         @id @default(uuid()) @db.Uuid
  number                Int            @unique @default(autoincrement())
  type                  PaymentType
  status                PaymentStatus  @default(POSTED)
  saleId                String?        @db.Uuid
  saleReturnId          String?        @db.Uuid
  purchaseId            String?        @db.Uuid
  purchaseReturnId      String?        @db.Uuid
  paymentMethodId       String         @db.Uuid
  cashSessionId         String?        @db.Uuid
  amount                Decimal        @db.Decimal(18, 2)
  tenderedAmount        Decimal?       @db.Decimal(18, 2)
  changeAmount          Decimal?       @db.Decimal(18, 2)
  externalReference     String?        @db.VarChar(160)
  notes                 String?        @db.VarChar(500)
  createdByActorId      String         @db.VarChar(120)
  createdAt             DateTime       @default(now())
  reversedAt            DateTime?
  reversedByActorId     String?        @db.VarChar(120)
  reversalReason        String?        @db.VarChar(500)
  reversalCashSessionId String?        @db.Uuid
  sale                  Sale?          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleReturn            SaleReturn?    @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  purchase              Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  purchaseReturn        PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id], onDelete: Restrict)
  paymentMethod         PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  cashSession           CashSession?   @relation("OriginalPaymentSession", fields: [cashSessionId], references: [id], onDelete: Restrict)
  reversalCashSession   CashSession?   @relation("ReversalPaymentSession", fields: [reversalCashSessionId], references: [id], onDelete: Restrict)
  cashMovements         CashMovement[]

  @@index([saleId, type, status, createdAt])
  @@index([saleReturnId, status, createdAt])
  @@index([purchaseId, type, status, createdAt])
  @@index([purchaseReturnId, status, createdAt])
  @@index([paymentMethodId, createdAt])
  @@index([cashSessionId, createdAt])
  @@index([status, createdAt])
}

model CashMovement {
  id            String           @id @default(uuid()) @db.Uuid
  cashSessionId String           @db.Uuid
  paymentId     String?          @db.Uuid
  type          CashMovementType
  amount        Decimal          @db.Decimal(18, 2)
  reason        String?          @db.VarChar(500)
  actorId       String           @db.VarChar(120)
  createdAt     DateTime         @default(now())
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  payment       Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, type])
  @@index([cashSessionId, createdAt])
  @@index([paymentId])
  @@index([type, createdAt])
}

// General accounting, workshop, and intelligence remain out of scope.
